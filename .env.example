# Copy to .env for local development. NEVER commit .env. Placeholders only below.
# Full variable table (purpose, secret or not, where the value comes from): docs/labs/lab-05/deployment.md

# --- Application -------------------------------------------------------------
# PostgreSQL connection string (secret in the cloud: Secret Manager)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cpms?schema=public"
# Signs session cookies (secret). Optional for `npm run dev`; REQUIRED for docker compose and the
# cloud, where NODE_ENV=production and the app refuses to start without a private value.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_EXPIRES_IN="8h"
# "true" when served over HTTPS (Cloud Run); "false" for plain http://localhost
COOKIE_SECURE="false"
UNIVERSITY_EMAIL_DOMAIN="student.university.ac.th"
# Cloud Run injects PORT automatically
PORT=8080

# --- Demo seed (prisma/seed.ts) and tests ------------------------------------
# Password given to ALL seeded demo accounts. Required to seed and to run the tests.
# Local placeholder only; in the cloud it comes from Secret Manager.
DEMO_USER_PASSWORD="change-me-local-demo"
# "false" skips the demo seed (the cloud migration job sets it when deploy.sh runs without --demo).
# Leave unset locally.
# SEED_DEMO_DATA=
# "true" wipes every table before seeding. LOCAL ONLY; never set in the cloud.
SEED_RESET="false"

# --- docker compose (local) --------------------------------------------------
POSTGRES_USER="cpms"
POSTGRES_PASSWORD="change-me-local-db"
POSTGRES_DB="cpms"
